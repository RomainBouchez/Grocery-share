# SQLite database (parfait pour Raspberry Pi)
DATABASE_URL="file:./dev.db"

# Secret utilisé pour signer les sessions (générer une valeur aléatoire en prod)
SESSION_SECRET="change-me-in-production"

# Cookie de session marqué `Secure` (à activer derrière un proxy HTTPS).
# COOKIE_SECURE="true"

# --- V3 : scan de ticket OCR via le CLI Claude Code (`claude -p`) ---
# Le binaire `claude` doit être installé ET authentifié dans l'environnement
# qui exécute l'app (cf. README pour le cas Docker).
# CLAUDE_CLI_BIN="claude"            # chemin/nom du binaire (défaut: claude)
# CLAUDE_OCR_MODEL="claude-sonnet-4-6"  # force un modèle (sinon défaut du CLI)
# OCR_TIMEOUT_MS="120000"           # délai max d'analyse d'un ticket
# MATCH_THRESHOLD="0.6"             # seuil de fuzzy matching (0..1)
# UPLOAD_DIR="/data/uploads"        # dossier d'écriture des photos de ticket
