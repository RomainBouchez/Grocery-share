// GrocyShare — schéma de base de données
// SQLite via Prisma : léger, parfait pour un Raspberry Pi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Utilisateurs & auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?  // hash scrypt "salt:clé" — null pour les comptes hérités (à définir à la 1re connexion)
  isActive     Boolean  @default(true) // un compte doit être activé par l'admin ; l'inscription force `false`, les comptes hérités restent `true`
  color        String?  // couleur d'avatar choisie (sinon dérivée de l'id)
  createdAt    DateTime @default(now())

  memberships     GroupMember[]
  addedItems      ListItem[]        @relation("ItemAddedBy")
  participations  ItemParticipant[]
  receiptsPaid    Receipt[]         @relation("ReceiptPaidBy")
  balancesFrom    Balance[]         @relation("BalanceFrom")
  balancesTo      Balance[]         @relation("BalanceTo")
  settlementsFrom     Settlement[]  @relation("SettlementFrom")
  settlementsTo       Settlement[]  @relation("SettlementTo")
  settlementsRecorded Settlement[]  @relation("SettlementBy")
  products        UserProduct[]
  sessions        Session[]
  pushSubscriptions PushSubscription[]
}

// Abonnement Web Push (PWA) d'un appareil/navigateur de l'utilisateur.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Session simple par cookie (auth « magic link / code PIN » à brancher ensuite).
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Groupes
// ---------------------------------------------------------------------------

model Group {
  id         String   @id @default(cuid())
  name       String
  color      String?  // couleur de la pastille (sinon dérivée de l'id)
  icon       String?  // nom d'icône Solar (sinon "Home")
  inviteCode String   @unique // code court pour rejoindre par lien/code
  expenseSharingEnabled Boolean @default(false) // module « Tricount » (balance) activé pour ce groupe
  createdAt  DateTime @default(now())

  members     GroupMember[]
  lists       ShoppingList[]
  balances    Balance[]
  settlements Settlement[]
  tags        Tag[]
  productTags GroupProductTag[]
}

// Tag/rayon par groupe (ex : « Fruits & légumes »). Partagé entre membres.
model Tag {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  icon      String   // nom d'icône Solar
  color     String   // hex
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  items       ListItem[]
  productTags GroupProductTag[]

  @@unique([groupId, name])
  @@index([groupId])
}

// Mémoire produit→tag par groupe : un libellé qui revient retrouve son rayon.
model GroupProductTag {
  id      String @id @default(cuid())
  groupId String
  label   String
  tagId   String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([groupId, label])
  @@index([groupId])
}

model GroupMember {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  role     String   @default("member") // "owner" | "member"
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Listes de courses & articles
// ---------------------------------------------------------------------------

model ShoppingList {
  id        String   @id @default(cuid())
  groupId   String
  status    String   @default("planning") // "planning" | "shopping" | "done"
  shoppingByUserId  String?   // qui a déclaré « je vais faire les courses »
  shoppingStartedAt DateTime? // depuis quand
  createdAt DateTime @default(now())

  group    Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  items    ListItem[]
  receipts Receipt[]

  @@index([groupId])
}

model ListItem {
  id            String   @id @default(cuid())
  listId        String
  label         String
  addedByUserId String
  status        String   @default("pending") // "pending" | "bought" | "skipped"
  tagId         String?
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())

  list         ShoppingList      @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedBy      User              @relation("ItemAddedBy", fields: [addedByUserId], references: [id])
  tag          Tag?              @relation(fields: [tagId], references: [id], onDelete: SetNull)
  participants ItemParticipant[]
  receiptItems ReceiptItem[]

  @@index([listId])
}

// Qui participe à un article et avec combien de parts (façon Tricount).
model ItemParticipant {
  id     String @id @default(cuid())
  itemId String
  userId String
  parts  Int    @default(1)

  item ListItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([itemId])
}

// ---------------------------------------------------------------------------
// Retour de courses : ticket & Tricount (V2 / V3)
// ---------------------------------------------------------------------------

model Receipt {
  id           String   @id @default(cuid())
  listId       String
  paidByUserId String
  totalAmount  Float    @default(0)
  photoUrl     String?
  createdAt    DateTime @default(now())

  list   ShoppingList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  paidBy User          @relation("ReceiptPaidBy", fields: [paidByUserId], references: [id])
  items  ReceiptItem[]

  @@index([listId])
}

model ReceiptItem {
  id            String  @id @default(cuid())
  receiptId     String
  rawLabel      String
  matchedItemId String?
  price         Float

  receipt     Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  matchedItem ListItem? @relation(fields: [matchedItemId], references: [id])

  @@index([receiptId])
}

model Balance {
  id         String  @id @default(cuid())
  groupId    String
  fromUserId String
  toUserId   String
  amount     Float
  settled    Boolean @default(false)

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser User  @relation("BalanceFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("BalanceTo", fields: [toUserId], references: [id])

  @@index([groupId])
}

// Journal des remboursements (façon Tricount). Append-only : un règlement = un
// transfert de `fromUser` (débiteur) vers `toUser` (créancier). La balance reste
// calculée en direct depuis les tickets ; chaque règlement vient l'éponger.
model Settlement {
  id          String   @id @default(cuid())
  groupId     String
  fromUserId  String   // a remboursé (débiteur)
  toUserId    String   // a reçu (créancier)
  amount      Float
  createdById String   // qui a saisi le règlement (audit)
  createdAt   DateTime @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser  User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser    User  @relation("SettlementTo", fields: [toUserId], references: [id])
  createdBy User  @relation("SettlementBy", fields: [createdById], references: [id])

  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Suggestions : base d'aliments perso (V4)
// ---------------------------------------------------------------------------

model UserProduct {
  id           String   @id @default(cuid())
  userId       String
  label        String
  lastBoughtAt DateTime?
  buyCount     Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([userId])
}
