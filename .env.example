# SQLite database (parfait pour Raspberry Pi)
DATABASE_URL="file:./dev.db"

# Secret utilisé pour signer les sessions (générer une valeur aléatoire en prod)
SESSION_SECRET="change-me-in-production"

# Cookie de session marqué `Secure` (à activer derrière un proxy HTTPS).
# COOKIE_SECURE="true"

# --- Web Push (PWA) : notifications « X fait les courses » ---
# Générer une paire de clés : `npx web-push generate-vapid-keys`
# La clé publique est exposée au client (préfixe NEXT_PUBLIC_).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@exemple.fr"

# Email de l'administrateur : ce compte voit la page /admin, est actif d'office
# et peut activer/désactiver les autres comptes. Les nouveaux comptes sont
# inactifs tant que l'admin ne les a pas validés.
ADMIN_EMAIL="romain@exemple.fr"

# --- V3 : scan de ticket OCR via le CLI Claude Code (`claude -p`) ---
# Le binaire `claude` doit être installé ET authentifié dans l'environnement
# qui exécute l'app (cf. README pour le cas Docker).
# CLAUDE_CLI_BIN="claude"            # chemin/nom du binaire (défaut: claude)
# CLAUDE_OCR_MODEL="claude-sonnet-4-6"  # force le modèle d'OCR (sinon défaut du CLI)
# CLAUDE_MATCH_MODEL="haiku"        # modèle du matching sémantique (défaut: haiku)
# OCR_TIMEOUT_MS="120000"           # délai max d'analyse d'un ticket
# MATCH_THRESHOLD="0.6"             # seuil du matching lexical de secours (0..1)
# UPLOAD_DIR="/data/uploads"        # dossier d'écriture des photos de ticket
